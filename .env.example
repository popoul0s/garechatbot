# Base de données
DATABASE_URL=postgres://gare:gare@localhost:5432/garechatbot

# Backend
BIND_ADDR=0.0.0.0:8080
DEFAULT_ORIGIN=Grenoble
# API Géo (communes françaises, gratuite, sans clé) : localise une destination sans gare
GEO_API_URL=https://geo.api.gouv.fr

# LLM : n'importe quelle API compatible OpenAI (/v1/chat/completions).
# Laisser LLM_BASE_URL vide => mode sans LLM (extraction par règles + réponse générée par gabarit).
#
# Auto-hébergé (Ollama) :
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=mistral
#   LLM_API_KEY=
# Cloud (Mistral API / OpenAI / autre fournisseur compatible) :
#   LLM_BASE_URL=https://api.mistral.ai/v1
#   LLM_MODEL=mistral-small-latest
#   LLM_API_KEY=xxx
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECS=60
